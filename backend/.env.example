APP_NAME=iam-api
APP_ENV=development
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://iam:iam@127.0.0.1:5432/iam
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
CREDENTIAL_CLEANUP_INTERVAL_SECONDS=3600
CREDENTIAL_CLEANUP_BATCH_SIZE=1000
OIDC_ISSUER=https://iam.example.com
OIDC_SIGNING_KEY_PATH=/run/iam-secrets/oidc-signing-key.pem
CONSOLE_PUBLIC_URL=https://iam.example.com
ALLOW_PUBLIC_REGISTRATION=false
# 独立注册 HMAC 密钥；仅开放注册时需要，至少 32 个随机字符，不能与 JWT 密钥共用。
PUBLIC_REGISTRATION_SECRET=
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password
CORS_ORIGINS=["http://localhost:5173"]
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=10
PASSWORD_RESET_TOKEN_MINUTES=30
PASSWORD_RESET_COOLDOWN_SECONDS=60
PUBLIC_REGISTRATION_CODE_MINUTES=10
PUBLIC_REGISTRATION_MAX_ATTEMPTS=5
PUBLIC_REGISTRATION_COOLDOWN_SECONDS=60
PUBLIC_REGISTRATION_DELIVERY_INTERVAL_SECONDS=5
