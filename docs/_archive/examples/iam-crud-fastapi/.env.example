# Copy to .env.local after provision.py (or fill manually). Never commit secrets.
# App client_id=crud-demo uses permission_namespace=crud → codes crud.document.*
IAM_API_URL=http://127.0.0.1:8002
IAM_ISSUER=http://localhost:8002
IAM_APPLICATION_ID=
IAM_CLIENT_ID=crud-demo
IAM_CLIENT_SECRET=
IAM_REDIRECT_URI=http://localhost:8000/auth/callback
DEMO_USER_EMAIL=crud-demo@example.com
DEMO_USER_PASSWORD=
