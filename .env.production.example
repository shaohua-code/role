# Copy to .env.production.local and inject real values from the deployment secret store.
IAM_DOMAIN=iam.example.com
IAM_RELEASE_TAG=2026.09.27-change-me
# Use a URL-safe random secret (letters/numbers) so DATABASE_URL does not need password escaping.
IAM_POSTGRES_PASSWORD=replace-with-40-or-more-random-letters-and-numbers
IAM_JWT_SECRET=replace-with-at-least-32-random-characters
IAM_ADMIN_EMAIL=admin@example.com
# Used only by the one-time bootstrap-admin profile; remove from the deployment environment after bootstrap.
IAM_BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-16-random-characters
# 绿场破窗开关（默认 false，生产保持关闭）：true 时邮箱匹配引导账号且无平台角色也可进管理面，
# 但每条写审计带 break_glass=true；仅灾备恢复临时开启，平台权限真相始终是角色绑定。
# ALLOW_BOOTSTRAP_EMAIL_BYPASS=false
# Absolute path on the Linux deployment host to a managed PKCS8 RSA private key, >= 2048 bits.
IAM_OIDC_SIGNING_KEY_FILE=/secure/iam/oidc-signing-key.pem
# 仅在 OIDC 双密钥轮换重叠阶段使用；通过 compose.production.key-rotation.yaml 挂载备用 RSA 私钥。
# IAM_OIDC_PREVIOUS_SIGNING_KEY_FILE=
# Optional; required only if an authorized model gateway reports usage.
IAM_MODEL_USAGE_API_KEY=
# Keep false until the gateway contract and fail-closed behavior are accepted and verified.
IAM_MODEL_QUOTA_ENFORCEMENT_ENABLED=false
# Optional: SMTP is used for password recovery; ToC registration additionally requires the global flag,
# a per-application open policy, an ordinary role and published terms/privacy URLs.
IAM_ALLOW_PUBLIC_REGISTRATION=false
# Only required when public registration is enabled; use a stable independent random secret (>=32 chars).
IAM_PUBLIC_REGISTRATION_SECRET=
IAM_INVITATION_EMAIL_ENABLED=false
IAM_SMTP_HOST=
IAM_SMTP_PORT=587
IAM_SMTP_USERNAME=
IAM_SMTP_PASSWORD=
IAM_SMTP_FROM=
IAM_SMTP_STARTTLS=true
IAM_SMTP_SSL=false
IAM_SMTP_TIMEOUT_SECONDS=10
IAM_PASSWORD_RESET_TOKEN_MINUTES=30
IAM_PASSWORD_RESET_COOLDOWN_SECONDS=60
IAM_PUBLIC_REGISTRATION_CODE_MINUTES=10
IAM_PUBLIC_REGISTRATION_MAX_ATTEMPTS=5
IAM_PUBLIC_REGISTRATION_COOLDOWN_SECONDS=60
IAM_PUBLIC_REGISTRATION_DELIVERY_INTERVAL_SECONDS=5
# Failed sign-ins are counted for 15 minutes: 8 per account/source and 60 per source.
IAM_LOGIN_ATTEMPT_WINDOW_SECONDS=900
IAM_LOGIN_IDENTIFIER_MAX_FAILURES=8
IAM_LOGIN_IP_MAX_FAILURES=60
IAM_LOGIN_BLOCK_SECONDS=900
# Reclaim expired short-lived authentication records every hour, up to 1000 rows per table/run.
IAM_CREDENTIAL_CLEANUP_INTERVAL_SECONDS=3600
IAM_CREDENTIAL_CLEANUP_BATCH_SIZE=1000
