# 本地开发配置；请复制为仓库根目录 .env 并替换每一项，不要提交真实密钥。
IAM_POSTGRES_PASSWORD=replace-with-a-random-local-database-password
IAM_JWT_SECRET=replace-with-at-least-32-random-characters-before-starting
IAM_ADMIN_EMAIL=admin@example.com
IAM_ADMIN_PASSWORD=replace-with-a-random-password-at-least-16-characters
# 仅部署模型网关计量上报时生成 32+ 字符随机值；网关与 IAM 服务端使用同一值。
IAM_MODEL_USAGE_API_KEY=replace-with-a-random-secret-at-least-32-characters
# 配额路由按推荐策略开发完成；业务网关验收且产品确认前保持关闭。
IAM_MODEL_QUOTA_ENFORCEMENT_ENABLED=false
# 可选：配置邮件服务后才开放密码找回；凭据只放本机 .env，不要提交真实值。
# 可选：邀请邮件另需显式启用；默认由管理员手动交付一次性链接。
IAM_ALLOW_PUBLIC_REGISTRATION=false
# 管理台登录页绑定 OAuth client_id 时可展示「邮箱注册」（仍须全局开关 + SMTP + 应用 open 策略）。
IAM_CONSOLE_REGISTRATION_CLIENT_ID=
# 独立注册 HMAC 密钥；仅开放注册时需要，至少 32 个随机字符，不能与 JWT 密钥共用。
IAM_PUBLIC_REGISTRATION_SECRET=
IAM_INVITATION_EMAIL_ENABLED=false
# 163 示例：smtp.163.com:465 + SSL；密码为 SMTP 授权码（非登录密码）
IAM_SMTP_HOST=smtp.163.com
IAM_SMTP_PORT=465
IAM_SMTP_USERNAME=your-163-address@163.com
IAM_SMTP_PASSWORD=replace-with-163-smtp-authorization-code
IAM_SMTP_FROM=your-163-address@163.com
IAM_SMTP_STARTTLS=false
IAM_SMTP_SSL=true
IAM_SMTP_TIMEOUT_SECONDS=10
IAM_PASSWORD_RESET_TOKEN_MINUTES=30
IAM_PASSWORD_RESET_COOLDOWN_SECONDS=60
# ToC 注册仍需逐应用 open 策略、普通角色、发布的协议链接和 SMTP；默认全局关闭。
IAM_PUBLIC_REGISTRATION_CODE_MINUTES=10
IAM_PUBLIC_REGISTRATION_MAX_ATTEMPTS=5
IAM_PUBLIC_REGISTRATION_COOLDOWN_SECONDS=60
IAM_PUBLIC_REGISTRATION_DELIVERY_INTERVAL_SECONDS=5
# 登录失败窗口为 15 分钟；每个账号/来源 8 次、单来源 60 次失败后冷却 15 分钟。
IAM_LOGIN_ATTEMPT_WINDOW_SECONDS=900
IAM_LOGIN_IDENTIFIER_MAX_FAILURES=8
IAM_LOGIN_IP_MAX_FAILURES=60
IAM_LOGIN_BLOCK_SECONDS=900
# 到期认证凭证自动回收；每个 API worker 安全分批领取，不影响其他数据保留策略。
IAM_CREDENTIAL_CLEANUP_INTERVAL_SECONDS=3600
IAM_CREDENTIAL_CLEANUP_BATCH_SIZE=1000
IAM_API_PORT=8002
IAM_CONSOLE_PORT=5175
# 部署到真实 HTTPS 域名时同时配置公开 issuer 与登录控制台地址。
IAM_OIDC_ISSUER=http://localhost:8002
IAM_CONSOLE_PUBLIC_URL=http://localhost:5175
